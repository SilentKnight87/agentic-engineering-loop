{
  "name": "agentic-engineering-loop-skill",
  "version": "0.1.0",
  "description": "Portable agent skill for the agentic engineering loop.",
  "license": "MIT",
  "bin": {
    "agentic-engineering-loop-install": "bin/install.js"
  },
  "files": [
    "skills",
    "bin",
    "install.sh",
    "README.md",
    ".claude-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilentKnight87/agentic-engineering-loop.git"
  },
  "keywords": [
    "agent-skills",
    "hermes",
    "claude-code",
    "codex",
    "opencode"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "markdownlint": "0.41.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "quality": "node scripts/quality.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node .agents/skills/verify-agentic-engineering-loop/scripts/drive.mjs",
    "check:duplicates": "jscpd . .agents --format javascript,bash --min-lines 8 --min-tokens 100 --fail-on-new-clones 0 --ignore \"**/node_modules/**,**/.verify/**\" --reporters json --output .verify/duplication"
  },
  "engines": {
    "node": ">=22"
  }
}
