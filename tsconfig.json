  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "types": ["node"]
  },
  "include": ["**/*.js", "**/*.mjs", "**/*.cjs", ".agents/**/*.js", ".agents/**/*.mjs", ".agents/**/*.cjs"],
  "exclude": ["node_modules", ".verify", ".claude"]
}
